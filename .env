# ============================================================
#  .env — Variáveis de Ambiente da Stack Unificada
# ============================================================

# --- PostgreSQL (Configuração Global) ---
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fastpass
POSTGRES_DB=chatwoot_db

# --- Redis (Configuração Global) ---
REDIS_URL=redis://:fastpass@redis:6379/0
REDIS_PASSWORD=fastpass

# --- Chatwoot (Obrigatórias) ---
# IP 10.10.0.153 (conforme identificado no seu terminal)
CHATWOOT_URL=http://10.10.0.153:3000
FRONTEND_URL=http://10.10.0.153:3000
SECRET_KEY_BASE=abc06d444cd3eb859457e08421121a0314ac69d0ef9fbee209224d633ffa9570
CHATWOOT_SECRET_KEY=abc06d444cd3eb859457e08421121a0314ac69d0ef9fbee209224d633ffa9570

# Configurações de Ambiente
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
ACTIVE_STORAGE_SERVICE=local

# --- Evolution API ---
EVOLUTION_URL=http://10.10.0.153:8080
EVOLUTION_API_KEY=BQYHJGJHJ
LANGUAGE=pt-BR

# Persistência de Dados (Evolution no Postgres)
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://postgres:fastpass@postgres:5432/evolution_db?schema=public'
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_DATA_LABELS=true

# Cache Redis (Evolution) - DB 1 para não misturar com Chatwoot
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:fastpass@redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution-cache
CACHE_REDIS_SAVE_INSTANCES=true

# --- N8N ---
N8N_HOST=10.10.0.153
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://10.10.0.153:5678
N8N_ENCRYPTION_KEY=57f3c547f8b74ca3c8a59feef45a7cae